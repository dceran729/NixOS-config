configuration {
    modi: "drun,run,filebrowser";
    show-icons: true;
    display-drun: "";
    display-run: "";
    display-filebrowser: "";
    drun-match-fields: "name";
    drun-display-format: "{name}";
    matching: "fuzzy";
    sort: true;
    sorting-method: "levenshtein";
    window-format: "{w} · {c} · {t}";
    kb-mode-next: "Tab";
    kb-element-next: "";
    kb-row-down: "Down,Control+n";
}

* {
    /* ================================================== */
    /* ZMIENNE GLOBALNE */
    /* ================================================== */
    font:            "JetBrainsMono Nerd Font 12";
    bg-col:          #141414FF;
    bg-alt:          #1E1E1EFF;
    text-col:        #FFFFFFFF;
    border-col:      #00c6fcFF;

    rounding-size:   5px;
    /* ================================================== */
}

window {
    enabled: true;
    location: center;
    anchor: center;
    fullscreen: false;
    width: 800px;
    border: 3px;
    border-radius: var(rounding-size);
    border-color: var(border-col);
    background-color: var(bg-col);
}

mainbox {
    enabled: true;
    spacing: 10px;
    padding: 30px;
    background-color: var(bg-col);
    children: [ "inputbar", "listview" ];
}

inputbar {
    enabled: true;
    spacing: 10px;
    background-color: var(bg-col);
    text-color: var(text-col);
    children: [ "textbox-prompt-colon", "entry", "mode-switcher" ];
}

textbox-prompt-colon {
    enabled: true;
    expand: false;
    padding: 5px 10px;
    str: "";
    background-color: var(bg-alt);
    text-color: var(border-col);
    border-radius: var(rounding-size);
}

entry {
    enabled: true;
    padding: 5px 10px;
    background-color: var(bg-alt);
    text-color: var(text-col);
    border-radius: var(rounding-size);
    placeholder: "Szukaj...";
    placeholder-color: #888888FF;
}

listview {
    enabled: true;
    columns: 1;
    lines: 8;
    cycle: true;
    dynamic: true;
    scrollbar: true;
    layout: vertical;
    spacing: 8px;
    background-color: var(bg-col);
}

scrollbar {
    handle-width: 5px;
    handle-color: var(border-col);
    border-radius: var(rounding-size);
    background-color: var(bg-alt);
}

element {
    enabled: true;
    spacing: 10px;
    padding: 12px 15px;
    border-radius: var(rounding-size);
    background-color: var(bg-col);
    text-color: var(text-col);
}

element normal.normal, element alternate.normal {
    background-color: var(bg-col);
    text-color: var(text-col);
}

element selected.normal {
    background-color: var(bg-alt);
    text-color: var(border-col);
}

element-icon {
    background-color: inherit;
    text-color: inherit;
    size: 32px;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    vertical-align: 0.5;
}

mode-switcher {
    enabled: true;
    spacing: 10px;
    background-color: var(bg-col);
}

button {
    /* Wartości: góra, prawo, dół, lewo */
    /* Większy prawy padding (np. 15px) pcha ikonę w lewo */
    padding: 0px 15px 0px 10px;
    border-radius: var(rounding-size);
    background-color: var(bg-alt);
    text-color: var(text-col);
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

button selected {
    background-color: var(border-col);
    text-color: var(bg-col);
}
