configuration {
    show-icons: false;
}

* {
    /* ================================================== */
    /* ZMIENNE GLOBALNE */
    /* ================================================== */
    font:            "JetBrainsMono Nerd Font 12";
    element-font:    "feather 36";
    bg-col:          #141414FF;
    bg-alt:          #1E1E1EFF;
    text-col:        #FFFFFFFF;
    border-col:      #00c6fcFF;

    rounding-size:   5px;
    /* ================================================== */

    box-spacing:      30px;
    box-margin:       32% 30%;
    message-margin:   0px 5%;
    list-spacing:     30px;
    general-padding:  15px;
    element-padding:  35px 10px;
}

window {
    enabled:          true;
    fullscreen:       true;
    location:         center;
    anchor:           center;
    width:            100%;
    background-color: var(bg-col);
}

mainbox {
    enabled:          true;
    spacing:          var(box-spacing);
    padding:          var(box-margin);
    background-color: var(bg-col);
    children:         [ "message", "listview" ];
}

inputbar {
    enabled:          true;
    spacing:          0px;
    background-color: var(bg-col);
    text-color:       var(text-col);
    children:         [ "dummy", "textbox-prompt-colon", "prompt", "dummy" ];
}

dummy {
    background-color: var(bg-col);
}

textbox-prompt-colon {
    enabled:          true;
    expand:           false;
    str:              "SYSTEM";
    padding:          var(general-padding);
    border-radius:    var(rounding-size);
    background-color: var(bg-alt);
    text-color:       var(border-col);
}

prompt {
    enabled:          true;
    padding:          var(general-padding);
    border-radius:    var(rounding-size);
    background-color: var(border-col);
    text-color:       var(bg-col);
}

message {
    enabled:          true;
    margin:           var(message-margin);
    padding:          var(general-padding);
    border-radius:    var(rounding-size);
    background-color: var(bg-alt);
    text-color:       var(text-col);
}

textbox {
    vertical-align:   0.5;
    horizontal-align: 0.5;
    background-color: inherit;
    text-color:       inherit;
}

listview {
    enabled:          true;
    layout:           vertical;
    columns:          3;
    lines:            1;
    cycle:            true;
    dynamic:          true;
    spacing:          var(list-spacing);
    background-color: var(bg-col);
}

element {
    enabled:          true;
    padding:          var(element-padding);
    border-radius:    var(rounding-size);
    background-color: var(bg-alt);
    text-color:       var(text-col);
}

element-text {
    vertical-align:   0.5;
    horizontal-align: 0.5;
    font:             var(element-font);
    background-color: inherit;
    text-color:       inherit;
}

element selected.normal {
    background-color: var(border-col);
    text-color:       var(bg-col);
}
